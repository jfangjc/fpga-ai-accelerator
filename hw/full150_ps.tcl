# Model the board's existing IOPLL; legal peripheral divisors are model-only.
# Deployment does not execute psu_init or change a PS PLL.
set_property -dict {
 CONFIG.PSU__PSS_REF_CLK__FREQMHZ 33.333333
 CONFIG.PSU__OVERRIDE__BASIC_CLOCK 1
 CONFIG.PSU__CRL_APB__IOPLL_CTRL__FBDIV 90
 CONFIG.PSU__CRL_APB__IOPLL_CTRL__DIV2 1
 CONFIG.PSU__CRL_APB__PL0_REF_CTRL__DIVISOR0 15
 CONFIG.PSU__CRL_APB__PL0_REF_CTRL__DIVISOR1 1
 CONFIG.PSU__CRL_APB__PL1_REF_CTRL__DIVISOR0 10
 CONFIG.PSU__CRL_APB__PL1_REF_CTRL__DIVISOR1 1
 CONFIG.PSU__CRL_APB__IOPLL_TO_FPD_CTRL__DIVISOR0 3
 CONFIG.PSU__CRL_APB__AMS_REF_CTRL__DIVISOR0 30
 CONFIG.PSU__CRL_APB__I2C1_REF_CTRL__DIVISOR0 15
 CONFIG.PSU__CRL_APB__SPI1_REF_CTRL__DIVISOR0 8
 CONFIG.PSU__CRL_APB__TIMESTAMP_REF_CTRL__DIVISOR0 15
 CONFIG.PSU__CRL_APB__LPD_SWITCH_CTRL__DIVISOR0 3
 CONFIG.PSU__CRL_APB__DBG_LPD_CTRL__DIVISOR0 6
 CONFIG.PSU__CRL_APB__LPD_LSBUS_CTRL__DIVISOR0 15
 CONFIG.PSU__CRL_APB__ADMA_REF_CTRL__DIVISOR0 3
 CONFIG.PSU__CRL_APB__IOU_SWITCH_CTRL__DIVISOR0 6
 CONFIG.PSU__CRL_APB__PCAP_CTRL__DIVISOR0 8
} [get_bd_cells ps]
